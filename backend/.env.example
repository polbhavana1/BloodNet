# MongoDB Database Connection
MONGODB_URI=mongodb://localhost:27017/bloodnet

# Backend Server Port
PORT=5000

# JWT Authentication Secret (Generate with: openssl rand -base64 32)
JWT_SECRET=your_secure_jwt_secret_key_here_change_this_in_production

# Google Maps API Key (Get from: https://console.cloud.google.com/)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Optional: Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Optional: File Upload Settings
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Development/Production Mode
NODE_ENV=development
